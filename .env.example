# ============================================================
# INTERN MANAGEMENT FRONTEND — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# =====================
# API
# =====================
# URL of the backend API server
VITE_API_BASE_URL=http://localhost:8080

# =====================
# OPTIONAL FEATURES
# =====================
# Set to 'true' to enable debug mode in development
VITE_DEBUG=false

# Application name displayed in browser title
VITE_APP_NAME=Intern Management System
